PORT=3000
DB_PATH=./data/server.sqlite
INVITE_CODE=replace-with-a-random-secret-at-least-24-characters
APNS_MODE=dry-run
POLL_SECONDS=75
ENABLE_ESTIMATES=false
# Fill in after Apple Developer enrollment; then set APNS_MODE=live.
APNS_BUNDLE_ID=com.zimri.SleeperLive
APNS_TEAM_ID=
APNS_KEY_ID=
# Either an absolute path to the .p8 key, or APNS_KEY_P8 in Railway secrets.
APNS_KEY_FILE=

# Automatic registration is OFF until the iPhone App Attest checkpoint is tested.
APP_ATTEST_ENABLED=false
# App ID Prefix from Apple Developer Identifiers (usually, but not always, Team ID).
APP_ATTEST_APP_ID_PREFIX=
# Keep false for TestFlight/App Store. Enable only for deliberate development tests.
APP_ATTEST_ALLOW_DEVELOPMENT=false

# Optional separate production key for TestFlight/App Store; keep the default sandbox key above.
APNS_PRODUCTION_KEY_ID=
APNS_PRODUCTION_KEY_FILE=
# Set APNS_PRODUCTION_KEY_P8 in Railway secrets, never commit a real key.
