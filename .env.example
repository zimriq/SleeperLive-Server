PORT=3000
DB_PATH=./data/server.sqlite
INVITE_CODE=replace-with-a-random-secret-at-least-24-characters
APNS_MODE=dry-run
POLL_SECONDS=75
ENABLE_ESTIMATES=false
# Fill in after Apple Developer enrollment; then set APNS_MODE=live.
APNS_BUNDLE_ID=com.zimri.SleeperLive
APNS_TEAM_ID=
APNS_KEY_ID=
# Either an absolute path to the .p8 key, or APNS_KEY_P8 in Railway secrets.
APNS_KEY_FILE=
